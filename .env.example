# ---------- REQUIRED (the app refuses to store anything without these) ----------
# 32 random bytes, base64. Encrypts all answers and uploaded files at rest.
# Generate with: npm run keys:generate     (BACK THIS UP — losing it makes stored data unreadable)
DATA_ENCRYPTION_KEY=
# 32+ random bytes, base64. Signs admin session cookies.
SESSION_SECRET=

# ---------- Admin sign-in (the /admin area is disabled until both are set) ----------
ADMIN_EMAIL=you@arclo.example
# Generate with: npm run admin:hash -- "a long unique password"
ADMIN_PASSWORD_HASH=

# ---------- Public URL (used in emails) ----------
APP_URL=http://localhost:3000

# ---------- Storage location (keep OUTSIDE any public/static folder) ----------
# Default: ./.data   (SQLite database + encrypted uploads). Use a persistent volume in production.
# DATA_DIR=/var/lib/arclo-gbp

# ---------- Email (optional; uses Resend https://resend.com) ----------
# Without these, no emails are sent and the UI says so honestly.
RESEND_API_KEY=
EMAIL_FROM="Arclo <onboarding@your-verified-domain.com>"
ARCLO_NOTIFY_EMAIL=

# ---------- Behind a reverse proxy / CDN (Vercel, Cloudflare, nginx) ----------
# Set to true ONLY if the proxy overwrites X-Forwarded-For, so rate limiting sees real client IPs.
TRUST_PROXY=false

# ---------- Optional spam challenge (Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Public links shown on the form ----------
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
