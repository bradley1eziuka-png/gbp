# The form needs NO environment variables to work. Everything below is optional.

# Shown on the confirmation page so clients know where to send photos if they didn't upload them.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Links shown on the form. Privacy defaults to the built-in draft /privacy page (have it reviewed or replace it).
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Override the Formspree endpoint (defaults to https://formspree.io/f/mqpewrak). Mainly for testing.
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=
